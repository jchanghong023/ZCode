{
  "name": "zcode",
  "version": "3.18.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun run concurrently -k -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "bun run build:server && bun run build:web",
    "build:server": "bun run --cwd packages/server build",
    "build:web": "bun run --cwd packages/web build",
    "typecheck": "bun --bun run tsc -b packages/shared/tsconfig.testing.json packages/rpc packages/provider packages/model-option-map packages/session-control packages/design-runtime packages/shared packages/services packages/client packages/server packages/ui packages/web",
    "lint": "bun --bun run oxlint",
    "lint:fix": "bun --bun run oxlint --fix --fix-suggestions",
    "fmt": "bun --bun run oxfmt",
    "fmt:check": "bun --bun run oxfmt --check",
    "knip": "bun ./node_modules/knip/bin/knip.js",
    "clean": "bun scripts/clean.mjs",
    "clean:deps": "bun scripts/clean.mjs --dependencies",
    "dep:refs": "bun scripts/dep-refs.mjs",
    "bootstrap": "bun scripts/bootstrap.mjs",
    "architecture:check": "bun scripts/architecture/architecture-check.mjs check",
    "architecture:report": "bun scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "bun scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "bun scripts/architecture/architecture-check.mjs context",
    "architecture:adopt": "bun scripts/architecture/architecture-check.mjs adopt",
    "test:ut": "bun --bun ./node_modules/vitest/vitest.mjs run --project engineering test/ut",
    "test:ut:typecheck": "bun --bun ./node_modules/typescript/bin/tsc --project test/ut/tsconfig.json",
    "test:st": "bun --bun ./node_modules/vitest/vitest.mjs run --project st",
    "test:st:typecheck": "bun --bun ./node_modules/typescript/bin/tsc --project test/st/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "knip": "^6.0.6",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "patchedDependencies": {
      "@radix-ui/react-collapsible@1.1.12": "patches/@radix-ui__react-collapsible@1.1.12.patch",
      "@radix-ui/react-menu@2.1.16": "patches/@radix-ui__react-menu@2.1.16.patch",
      "@uiw/react-markdown-preview@5.2.1": "patches/@uiw__react-markdown-preview@5.2.1.patch",
      "vite@8.0.8": "patches/vite@8.0.8.patch"
    }
  }
}
