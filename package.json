{
  "name": "zcode",
  "version": "3.18.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @zcode/server dev\" \"pnpm --filter @zcode/web dev\"",
    "dev:server": "pnpm --filter @zcode/server dev",
    "dev:web": "pnpm --filter @zcode/web dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @zcode/server build",
    "build:web": "pnpm --filter @zcode/web build",
    "typecheck": "tsc -b packages/shared/tsconfig.testing.json packages/rpc packages/provider packages/model-option-map packages/session-control packages/design-runtime packages/shared packages/services packages/client packages/server packages/ui packages/web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "clean": "node scripts/clean.mjs",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "count-lines": "bash scripts/count-lines.sh",
    "bootstrap": "node scripts/bootstrap.mjs",
    "ci:assert-node": "node scripts/assert-node-version.mjs",
    "test:architecture": "node --test scripts/test/architecture-governance.test.mjs scripts/test/architecture-governance-review.test.mjs scripts/test/architecture-upstream-admission.test.mjs scripts/test/source-size-policy.test.mjs scripts/test/react-hooks-lint.test.mjs scripts/test/architecture-default-branch.test.mjs scripts/test/pre-push-worktree.test.mjs scripts/test/retired-app-unit-evidence.test.mjs scripts/test/session-control-boundary.test.mjs",
    "test:engineering": "vitest run --project engineering",
    "test:engineering:affected": "node scripts/run-affected-engineering-tests.mjs",
    "verify:pre-push": "node scripts/check-push-worktree.mjs && pnpm run lint && pnpm run test:architecture && pnpm run architecture:check -- --changed && pnpm run test:engineering:affected --scope push",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "architecture:adopt": "node scripts/architecture/architecture-check.mjs adopt",
    "docs:stale-phrases:check": "node scripts/check-stale-doc-phrases.mjs",
    "check:workspace-freshness": "node scripts/check-workspace-freshness.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "istanbul-lib-instrument": "6.0.3",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "knip": "^6.0.6",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "patchedDependencies": {
      "@radix-ui/react-collapsible@1.1.12": "patches/@radix-ui__react-collapsible@1.1.12.patch",
      "vitest@4.1.7": "patches/vitest@4.1.7.patch",
      "@radix-ui/react-menu@2.1.16": "patches/@radix-ui__react-menu@2.1.16.patch"
    }
  },
  "license": "Apache-2.0"
}
