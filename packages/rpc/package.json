{
  "name": "@zcode/rpc",
  "version": "1.0.0",
  "private": true,
  "description": "VS Code style IPC communication abstraction framework",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun --bun run tsc",
    "typecheck": "bun --bun run tsc -p tsconfig.json --noEmit --composite false",
    "demo:basic": "bun examples/01-basic-ipc.ts",
    "demo:proxy": "bun examples/02-proxy-channel.ts",
    "demo:messageport": "bun examples/03-messageport-ipc.ts",
    "demo:remote": "bun examples/04-remote-connection.ts",
    "lint": "bun --bun run oxlint",
    "lint:fix": "bun --bun run oxlint --fix"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
