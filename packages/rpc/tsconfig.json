{
  // rpc 是内部源码 workspace 包：package.json 的 exports.types/default 都指向同一份 src 入口，
  // 这里保留 composite + 声明 emit，是因为 services/server/ui/client 的 project references
  // 会把 @zcode/rpc 的源码导入重定向到本工程生成的 dist 声明，避免同一批错误被放大打印。
  // dist 是构建/引用产物，不是运行时入口，干净工作区不需要它预先存在。
  // 注意：不要把 noEmit 写进本文件——被引用工程必须可 emit（否则消费者报 TS6310）；
  // 包内类型检查由 package.json 的 typecheck 脚本用 `--noEmit --composite false` 完成。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    // 修复原因：rrweb 传递依赖的旧 @types/css-font-loading-module 会和新版 TypeScript 内置 DOM 声明重复。
    // rpc 没继承根 tsconfig，之前没有跳过第三方声明检查，导致 bootstrap 在依赖类型冲突上失败。
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
