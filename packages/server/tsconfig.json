{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"],
  // server 直接 import shared / services / rpc，references 指向声明产物避免重复检查。
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../rpc" }
  ]
}
