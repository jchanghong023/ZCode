{
  "name": "@zcode/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "cd ../.. && bun --watch packages/server/src/entry-http.ts",
    "start": "bun dist/entry-http.js",
    "build": "bun build --target=bun --outdir=dist ./src/entry-http.ts",
    "lint": "bun --bun run oxlint",
    "lint:fix": "bun --bun run oxlint --fix"
  },
  "dependencies": {
    "@zcode/provider": "workspace:*",
    "@zcode/rpc": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/shared": "workspace:*",
    "hono": "^4.12.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
