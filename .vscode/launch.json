{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ZCode Web: Chrome (:5173)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/packages/web",
      "sourceMaps": true,
      "preLaunchTask": "zcode: dev (mock server + web)"
    },
    {
      "name": "ZCode Server: Mock (:3030)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/server/src/entry-http.ts",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3030"
      },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "zcode: web dev (:5173)"
    }
  ]
}
