{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zcode: mock server (:3030)",
      "type": "shell",
      "command": "bun run dev:server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "zcode-dev"
      },
      "problemMatcher": {
        "owner": "zcode-mock-server",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "localhost:3030"
        }
      }
    },
    {
      "label": "zcode: web dev (:5173)",
      "type": "shell",
      "command": "bun run dev:web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "zcode-dev"
      },
      "problemMatcher": {
        "owner": "zcode-web-vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready in [0-9]+ ms"
        }
      }
    },
    {
      "label": "zcode: dev (mock server + web)",
      "dependsOn": ["zcode: mock server (:3030)", "zcode: web dev (:5173)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
