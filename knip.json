        "src/zcode-protocol-v4/session-data/contract.ts",
        "src/**/module.ts",
        "src/**/contract.example.ts"
      ]
    },
    "packages/design-runtime": {
      "entry": ["src/module.ts", "src/contract.example.ts"]
    },
    "packages/services": {
