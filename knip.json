        "src/components/ui/*.tsx",
        "src/components/mobile-ui/*.{ts,tsx}",
        "src/components/ai-elements/*.tsx",
        "src/components/icons/*.ts",
        "src/components/lib/*.ts",
        "src/components/ClientSceneLucideIcon.tsx",
        "src/components/ModelInputCapabilityBadge.tsx",
        "src/components/TaskTitleOverflowText.tsx",
