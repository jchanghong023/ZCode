        "src/lib/imagePreviewDownload.ts",
        "src/v4/ConversationImageFileMention.tsx",
        "src/conversation-user-input-presentation/contract.ts",
        "src/v4/ConversationUserInputBubble.tsx",
        "src/composer-edit-mode/index.ts",
